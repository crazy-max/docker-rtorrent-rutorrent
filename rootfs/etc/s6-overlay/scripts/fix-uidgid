#!/bin/sh

set -e

if [ -n "${PGID}" ] && [ "${PGID}" != "$(id -g rtorrent)" ]; then
  echo "Switching to PGID ${PGID}..."
  groupmod -o -g "${PGID}" rtorrent
fi
if [ -n "${PUID}" ] && [ "${PUID}" != "$(id -u rtorrent)" ]; then
  echo "Switching to PUID ${PUID}..."
  usermod -o -u "${PUID}" rtorrent
fi
